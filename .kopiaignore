# Kopia ignore rules for the kadishutu repository.
#
# This file only affects Kopia snapshots taken from this directory; it has no
# effect on git. The goal is to keep the backup small by skipping reproducible
# environments and build output while still backing up source, docs, locks and
# the git history.

# pixi environments and caches (large and fully reproducible from pixi.lock)
.pixi/

# Python virtual environments and bytecode
.venv/
venv/
env/
ENV/
__pycache__/
*.py[cod]
*.pyo

# Tool caches
.mypy_cache/
.pytest_cache/
.ruff_cache/
.pylint.d/
.hypothesis/
.coverage
.coverage.*
htmlcov/

# Build and packaging output
build/
dist/
*.egg-info/
*.spec

# PyInstaller / local portable app data
_appdata/

# Logs and temporary files produced by local tooling
*.log
*.tmp
*.bak

# Editor and OS metadata
.idea/
.vscode/
.DS_Store
Thumbs.db
desktop.ini

# ---------------------------------------------------------------------------
# Save lab (monorepo)
# Minimal backup: source, docs, tests, tooling, and notes only.
# No save data, extracted game data, or generated output.
# ---------------------------------------------------------------------------
lab/corpus/
lab/dumps/
lab/snapshots/
lab/tmp/
lab/cache/
lab/reports/
lab/artifacts/

# Save files and derived data
*.sav
*.sav.*
*.dec

# Extracted Unreal assets and decompiled output
*.pak
*.uexp
*.uasset
*.ubulk
*.usmap
*.kms
*.umap

# Archives and packaged binaries that may appear outside build/dist
*.zip
*.7z
*.exe
*.dll
*.pyd
*.so
*.whl
*.tar
*.gz

# Media and crash dumps
*.mp4
*.webm
*.png
*.jpg
*.jpeg
*.gif
*.dmp
*.stackdump

# UE4SS output
UE4SS_ObjectDump.txt
UE4SS.log
CXXHeaderDump/
UE4SS_SDK/
